{
  "name": "delta-lang",
  "version": "0.4.0",
  "description": "Delta — a LaTeX-inspired XML markup language for interactive papers, books and presentations, compiled to standalone offline HTML.",
  "type": "module",
  "license": "MIT",
  "author": "Rodrigo Ribeiro <rb.ribeiro9@gmail.com>",
  "homepage": "https://github.com/rbribeiro/delta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbribeiro/delta.git"
  },
  "bugs": {
    "url": "https://github.com/rbribeiro/delta/issues"
  },
  "keywords": [
    "latex",
    "markup",
    "xml",
    "katex",
    "math",
    "compiler",
    "offline",
    "html",
    "static-site",
    "papers",
    "cli",
    "delta"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "delta": "dist/cli.js",
    "dlt": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "assets": "tsx scripts/build.ts assets",
    "trace": "tsx scripts/trace.ts",
    "build": "tsx scripts/build.ts",
    "predev": "npm run assets",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run assets",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "npm run docs:site && npm run docs:exemplos",
    "predocs:site": "npm run assets && npm run trace",
    "docs:site": "tsx src/cli.ts build site/project.toml",
    "predocs:exemplos": "npm run assets",
    "docs:exemplos": "tsx src/cli.ts build site/exemplos/livro/project.toml && tsx src/cli.ts build site/exemplos/gigante/project.toml && tsx src/cli.ts build site/exemplos/artigo.dlt -o docs/exemplos/artigo.html && tsx src/cli.ts build site/exemplos/apresentacao.dlt -o docs/exemplos/apresentacao.html",
    "predocs:watch": "npm run assets && npm run trace",
    "docs:watch": "tsx src/cli.ts build site/project.toml --watch",
    "preexample": "npm run assets",
    "example": "tsx src/cli.ts build examples/hello.dlt -o out.html",
    "preexample:project": "npm run assets",
    "example:project": "tsx src/cli.ts build examples/project/project.toml",
    "preexample:collab": "npm run assets",
    "example:collab": "tsx src/cli.ts build examples/collab.dlt -o examples/collab.html",
    "prepack": "npm run build",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "katex": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
