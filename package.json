{
  "name": "delta-lang",
  "version": "0.5.0",
  "description": "Delta — a LaTeX-inspired XML markup language for interactive papers, books and presentations, compiled to standalone offline HTML.",
  "type": "module",
  "license": "MIT",
  "author": "Rodrigo Ribeiro <rb.ribeiro9@gmail.com>",
  "homepage": "https://github.com/rbribeiro/delta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbribeiro/delta.git"
  },
  "bugs": {
    "url": "https://github.com/rbribeiro/delta/issues"
  },
  "keywords": [
    "latex",
    "markup",
    "xml",
    "katex",
    "math",
    "compiler",
    "offline",
    "html",
    "static-site",
    "papers",
    "cli",
    "delta"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "bin": {
    "delta": "dist/cli.js",
    "dlt": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "assets": "node scripts/build.ts assets",
    "trace": "node scripts/trace.ts",
    "build": "node scripts/build.ts",
    "predev": "npm run assets",
    "dev": "node src/cli.ts",
    "pretest": "npm run assets",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "pretest:watch": "npm run assets",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "pretypecheck": "npm run assets",
    "typecheck": "tsc --noEmit",
    "docs": "npm run docs:site && npm run docs:exemplos",
    "predocs:site": "npm run assets && npm run trace",
    "docs:site": "node src/cli.ts build site/project.toml",
    "predocs:exemplos": "npm run assets",
    "docs:exemplos": "node src/cli.ts build site/exemplos/livro/project.toml && node src/cli.ts build site/exemplos/gigante/project.toml && node src/cli.ts build site/exemplos/artigo.dlt -o docs/exemplos/artigo.html && node src/cli.ts build site/exemplos/apresentacao.dlt -o docs/exemplos/apresentacao.html",
    "predocs:watch": "npm run assets && npm run trace",
    "docs:watch": "node src/cli.ts build site/project.toml --watch",
    "preexample": "npm run assets",
    "example": "node src/cli.ts build examples/hello.dlt -o out.html",
    "preexample:project": "npm run assets",
    "example:project": "node src/cli.ts build examples/project/project.toml",
    "preexample:collab": "npm run assets",
    "example:collab": "node src/cli.ts build examples/collab.dlt -o examples/collab.html",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "katex": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
